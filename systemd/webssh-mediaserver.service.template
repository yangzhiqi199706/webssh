[Unit]
Description=WebSSH Media Server (ZLMediaKit, GB/T 28181)
After=network.target
Before=webssh.service
PartOf=webssh.service

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__INSTALL_DIR__/mediaserver
Environment="LD_LIBRARY_PATH=__INSTALL_DIR__/mediaserver/lib"
ExecStart=__INSTALL_DIR__/mediaserver/MediaServer -d -c __INSTALL_DIR__/mediaserver/config.ini
Restart=always
RestartSec=3
LimitNOFILE=65535
StandardOutput=append:__INSTALL_DIR__/logs/mediaserver.out.log
StandardError=append:__INSTALL_DIR__/logs/mediaserver.err.log

[Install]
WantedBy=multi-user.target
